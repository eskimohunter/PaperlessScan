# Copy this file to .env and fill in your values
# Find your scanner device with: scanimage -L

SCANNER_DEVICE="escl:https://192.168.1.50:443"
OUTPUT_DIR="/data/scans"
RESOLUTION="300"
MODE="Color"
SOURCE="Auto"

# --- PAPERLESS Configuration ---
PAPERLESS_URL="https://paperless.example.com"  # Your Paperless URL (no trailing slash)
API_TOKEN="your-api-token-here"                # From Web UI → Profile → circular arrow button