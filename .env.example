# Copy this file to .env and fill in your values

# --- Scanner Configuration ---
# Scanner model advertised via mDNS (case-insensitive substring).
SCANNER_MODEL="WF-2930"
# Optional: MAC address to pick one of several scanners with the same model.
# SCANNER_MAC="f8:25:51:09:9c:8a"
RESOLUTION="300"
BACKGROUND_COLOR="3" # 0=White, 3=Black
OUTPUT_DIR="/home/user/Documents/scans"
TMP_SCAN_PATH="/tmp/PaperlessScan"
EPSONSCAN2="epsonscan2"

# --- Paperless Configuration ---
PAPERLESS_URL="https://paperless.example.com"  # Your Paperless URL (no trailing slash)
API_TOKEN=""                                    # From Web UI → Profile → circular arrow button
